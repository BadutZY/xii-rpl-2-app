{
    "cli": {
        "version": ">= 5.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "base": {
            "environment": "production",
            "android": {
                "image": "latest"
            }
        },
        "preview": {
            "extends": "base",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "extends": "base",
            "android": {
                "buildType": "app-bundle"
            }
        }
    }
}
